# Copy this file to .env, or run npm run setup.
# Do not put passwords, database files, or .env into Git.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/school.db
UPLOAD_PATH=./data/uploads
SESSION_HOURS=8
SESSION_IDLE_MINUTES=60
# Set true only behind a trusted, controlled reverse proxy that rewrites X-Forwarded-For.
TRUST_PROXY=false
# Production: NODE_ENV=production, APP_ORIGIN=https://your-school-domain.example
# Production port and host may be changed; development uses 3001 and 5173.
