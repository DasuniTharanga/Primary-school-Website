{
  "name": "meegahathanna-school-management",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "db:setup": "node scripts/db-setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.mjs",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "admin:reset-password": "node scripts/reset-password.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@fontsource/noto-sans-sinhala": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.446.0",
    "mysql2": "^3.11.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.5.3",
    "vite": "^7.3.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
